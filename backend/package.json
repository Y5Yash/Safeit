{
  "name": "safeit-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "seed:gazetteer": "tsx scripts/seed-gazetteer.ts",
